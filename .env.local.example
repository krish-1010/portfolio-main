# Copy this file to .env.local and fill in your values.

# CDN base URL for photos used in the macOS About view.
# Expected images (upload to your CDN):
#   krishna-hero.jpg  — portrait / selfie (shown as hero banner)
#   krishna-work.jpg  — optional second photo (candid / desk shot)
#
# Example (Cloudinary):
#   NEXT_PUBLIC_CDN_BASE=https://res.cloudinary.com/your-cloud/image/upload/v1234567890/portfolio
#
# Example (any CDN/raw URL folder):
#   NEXT_PUBLIC_CDN_BASE=https://cdn.yourdomain.com/images
#
# Leave empty to show gradient placeholder.
NEXT_PUBLIC_CDN_BASE=
